rules_version = '2';

// Default-deny: every read/write in this app currently goes through server
// actions using the Admin SDK (src/server/*-actions.ts), which bypasses
// these rules entirely. They exist to document intent and to fail closed
// if client-direct Firestore access is ever added — at that point, replace
// the blanket deny below with per-collection rules scoped to
// `request.auth != null` (and, where relevant, ownership checks).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
