# Copy this file to .env.local and fill in real values.
# .env* is already gitignored, so .env.local will never be committed.

# ── Firebase Client SDK (public — safe to expose to the browser) ──────────
# Firebase Console → Project settings → General → "Your apps" → SDK setup and configuration
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBUCvrOaF3nZEuNjZ_LUmz4Lf5sR6E0nV4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=compensation-asahi-livwell.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=compensation-asahi-livwell
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=gs://compensation-asahi-livwell.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1087976538278
NEXT_PUBLIC_FIREBASE_APP_ID=1:1087976538278:web:abcdef1234567890
# ── Firebase Admin SDK (server-only secret — never expose to the client) ──
# Firebase Console → Project settings → Service accounts → Generate new private key
# Downloads a JSON file. Base64-encode the ENTIRE file into a single line:
#   macOS/Linux:  base64 -i service-account.json | tr -d '\n'
# Never commit the raw JSON file.
FIREBASE_SERVICE_ACCOUNT_%

# Session cookie lifetime in seconds (Firebase createSessionCookie max is 14 days = 1209600)
SESSION_COOKIE_MAX_AGE_SECONDS=432000

NEXT_PUBLIC_FIRESTORE_DATABASE_ID=compensation

TEST_EMAIL=tothuy1811@gmail.com
TEST_PASSWORD=1234567890